# Production canonical origin and public form origin, e.g. https://your-domain.example
SITE_URL=

# Absolute path to a file on a writable persistent volume. Optional in development.
CONTACT_FILE=

# Optional local Ollama model. Blank uses keyword retrieval only.
OLLAMA_MODEL=

# Zoho Catalyst inquiry inbox (live site). Both must be set for the contact form to save inquiries.
# URL of the "inquiries" Advanced I/O function, e.g. https://<project-domain>.catalystserverless.com/server/inquiries/
INQUIRY_FUNCTION_URL=
# Long random secret. Set the same value as INQUIRY_KEY in the function's environment variables.
INQUIRY_FUNCTION_KEY=
